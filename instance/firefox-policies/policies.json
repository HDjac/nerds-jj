{
  "policies": {
    "ExtensionSettings": {
      "chatgpt-prompt-logger@nerds.local": {
        "installation_mode": "force_installed",
        "install_url": "file:///opt/chatgpt-prompt-logger.xpi"
      }
    },
    "Preferences": {
      "xpinstall.signatures.required": {
        "Value": false,
        "Status": "locked"
      }
    },
    "SearchEngines": {
      "Default": "NERDs Google Web",
      "Add": [
        {
          "Name": "NERDs Google Web",
          "URLTemplate": "https://www.google.com/search?udm=14&q={searchTerms}",
          "Method": "GET",
          "Description": "Conventional Google web results without AI Overviews"
        }
      ],
      "PreventInstalls": true
    }
  }
}
