{
  "manifest_version": 3,
  "name": "NERDS LLM Prompt Logger",
  "version": "0.9.0",
  "description": "Captures supported AI prompts and task-attributed browser observations; keeps Google Search in Web-only mode.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://google.com/*",
        "https://www.google.com/*"
      ],
      "js": [
        "google-web-ux.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js",
      "browser-events.js",
      "google-web-only.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-prompt-logger@nerds.local"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:60000/*",
    "http://localhost:60000/*",
    "https://google.com/*",
    "https://www.google.com/*"
  ]
}
