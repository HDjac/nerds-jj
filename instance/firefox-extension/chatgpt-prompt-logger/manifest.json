{
  "manifest_version": 3,
  "name": "NERDS LLM Prompt Logger",
  "version": "0.8.1",
  "description": "Captures supported AI prompts and task-attributed browser navigation/search observations in NERDs.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js",
      "browser-events.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-prompt-logger@nerds.local"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:60000/*",
    "http://localhost:60000/*"
  ]
}
